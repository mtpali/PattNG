+	writeString("i5", c.I5)
+	writeString("header_protection_key", headerKey)
+	writeString("content_padding_addition", c.ContentPaddingAddition)
+	writeString("rekey_after_time", c.RekeyAfterTime)
+	writeString("rekey_timeout", c.RekeyTimeout)
+	writeString("reject_after_time", c.RejectAfterTime)
+	writeString("keepalive_timeout", c.KeepaliveTimeout)
+	writeString("max_handshake_attempts", c.MaxHandshakeAttempts)
+	if c.RandomizePacketTrailers {
+		request.WriteString("random_trailers=true\n")
+	}
+	if c.DisableCookieReplies {
