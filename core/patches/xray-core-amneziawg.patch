+
+func TestAmneziaWGBindPreservesProtectedPackets(t *testing.T) {
+ for _, awg := range []bool{true, false} {
+  b := &bind{ctx: context.Background(), amnezia: awg, reserved: []byte{9,8,7}, listenFunc: func(context.Context)(net.PacketConn,error){ return net.ListenPacket("udp4","127.0.0.1:0") }}
+  fns, port, err := b.Open(0); if err != nil { t.Fatal(err) }; defer b.Close()
+  peer, err := net.ListenPacket("udp4","127.0.0.1:0"); if err != nil {t.Fatal(err)}; defer peer.Close()
+  peer.SetDeadline(time.Now().Add(2*time.Second)); b.PacketConn.SetDeadline(time.Now().Add(2*time.Second))
+  original := []byte{0x55,0x91,0xa2,0xb3,0x44,0x67}
+  if _,err=peer.WriteTo(original,&net.UDPAddr{IP:net.IPv4(127,0,0,1),Port:int(port)});err!=nil {t.Fatal(err)}
+  bufs:=[][]byte{make([]byte,2048)}; sizes:=make([]int,1);eps:=make([]conn.Endpoint,1)
+  if _,err=fns[0](bufs,sizes,eps);err!=nil {t.Fatal(err)}
+  want:=append([]byte(nil),original...);if !awg {copy(want[1:4],[]byte{0,0,0})}
+  if !bytes.Equal(bufs[0][:sizes[0]],want) {t.Fatalf("received packet corrupted (amnezia=%v)",awg)}
+  outgoing:=append([]byte(nil),original...)
+  if err=b.Send([][]byte{outgoing},eps[0]);err!=nil {t.Fatal(err)}
+  n,_,err:=peer.ReadFrom(bufs[0]);if err!=nil {t.Fatal(err)}
+  want=append([]byte(nil),original...);if !awg {copy(want[1:4],[]byte{9,8,7})}
+  if !bytes.Equal(bufs[0][:n],want) {t.Fatalf("sent packet corrupted (amnezia=%v)",awg)}
+ }
+}
+
+func TestAmneziaWGTunCloseUnblocksPendingPacket(t *testing.T) {
+ dev,_,err:=CreateNetTUN([]netip.Addr{netip.MustParseAddr("10.0.0.2")},nil,1280,nil)
+ if err!=nil {t.Fatal(err)}
+ tun:=dev.(*netTun)
+ for i:=0;i<netTunQueue;i++ { if err:=tun.WritePacket([]byte{0x45,0,0,20},nil);err!=nil {t.Fatal(err)} }
+ written:=make(chan struct{})
+ go func(){
+  defer close(written)
+  tun.WritePacket([]byte{0x45,0,0,20},nil)
+ }()
+ // No reader exists: the endpoint callback must be released by Close itself.
+ select {case <-written:t.Fatal("packet unexpectedly completed without a reader");case <-time.After(30*time.Millisecond):}
+ closed:=make(chan struct{})
+ go func(){tun.Close();tun.Close();close(closed)}()
+ select {case <-closed:case <-time.After(2*time.Second):t.Fatal("TUN close blocked")}
+ select {case <-written:case <-time.After(2*time.Second):t.Fatal("notifier stayed blocked after close")}
+ reader,_,err:=CreateNetTUN([]netip.Addr{netip.MustParseAddr("10.0.0.3")},nil,1280,nil)
+ if err!=nil {t.Fatal(err)}
+ read:=make(chan error,1)
+ go func(){_,e:=reader.Read([][]byte{make([]byte,2048)},make([]int,1),0);read<-e}()
+ reader.Close()
+ select {case e:=<-read:if e==nil{t.Fatal("closed read succeeded")};case <-time.After(2*time.Second):t.Fatal("reader stayed blocked")}
+}
+
+func TestAmneziaWGHandlerCannotInitializeAfterClose(t *testing.T) {
+ h:=&Handler{}
+ if err:=h.Close();err!=nil {t.Fatal(err)}
+ if err:=h.Close();err!=nil {t.Fatal(err)}
+ if err:=h.up(context.Background());err==nil{t.Fatal("up after close succeeded")}
+}
