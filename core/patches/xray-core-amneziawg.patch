+	for name, value := range map[string]uint32{
+		"s1": c.S1, "s2": c.S2, "s3": c.S3, "s4": c.S4,
+	} {
+		if value > 1<<16-1 {
+			return "", errors.New("AmneziaWG ", name, " must not exceed 65535")
+		}
+	}
+	for name, value := range map[string]string{
+		"h1": c.H1, "h2": c.H2, "h3": c.H3, "h4": c.H4,
+		"contentPaddingAddition": c.ContentPaddingAddition,
+		"rekeyAfterTime":         c.RekeyAfterTime,
+		"rekeyTimeout":           c.RekeyTimeout,
+		"rejectAfterTime":        c.RejectAfterTime,
+		"keepaliveTimeout":       c.KeepaliveTimeout,
+		"maxHandshakeAttempts":   c.MaxHandshakeAttempts,
+	} {
+		if err := validateAmneziaRange(name, value); err != nil {
+			return "", err
+		}
+	}
+	for name, value := range map[string]string{
+		"i1": c.I1, "i2": c.I2, "i3": c.I3, "i4": c.I4, "i5": c.I5,
+	} {
+		if err := validateAmneziaChain(name, value); err != nil {
+			return "", err
+		}
+	}
+	headerKey, err := parseAmneziaKey(c.HeaderProtectionKey)
+	if err != nil {
